# Copy to .env and fill in. NEVER commit .env.
GOOGLE_API_KEY=your-gemini-api-key-here

# Model names are configuration, not code. Check availability in Google AI Studio
# and change these if a model has been retired or renamed.
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
LLM_TEMPERATURE=0

MAX_QUERY_CHARS=1000
LOG_LEVEL=INFO

# Used by the Streamlit frontend (docker-compose overrides this to http://backend:8000)
BACKEND_URL=http://localhost:8000